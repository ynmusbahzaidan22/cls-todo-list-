# Local development only. Never use these placeholders for deployment.
APP_ENV=development
POSTGRES_DB=todo_dev
POSTGRES_USER=todo_dev
POSTGRES_PASSWORD=replace_with_a_long_local_only_password
DATABASE_URL=postgres://todo_runtime:replace_with_a_generated_runtime_password@127.0.0.1:15432/todo_dev?sslmode=disable
DATABASE_RUNTIME_ROLE=todo_runtime
# Test PostgreSQL is a separate Compose project, host port, and named volume.
TEST_POSTGRES_DB=todo_test
TEST_POSTGRES_USER=todo_test_admin
TEST_POSTGRES_PASSWORD=replace_with_a_separate_test_admin_password
TEST_DATABASE_URL=postgres://todo_test_admin:replace_with_a_separate_test_admin_password@127.0.0.1:25432/todo_test?sslmode=disable
RUNTIME_DATABASE_URL=postgres://todo_test_runtime:replace_with_a_separate_test_runtime_password@127.0.0.1:25432/todo_test?sslmode=disable
HTTP_ADDR=127.0.0.1:8080
DATABASE_MAX_CONNS=10
TRUSTED_ORIGIN=http://127.0.0.1:8080
SESSION_COOKIE_SECURE=false
TRUSTED_PROXY_CIDRS=
# Optional local override. If omitted, the API generates a process-local key.
# Generate securely in PowerShell: $rng=[Security.Cryptography.RandomNumberGenerator]::Create(); $bytes=New-Object byte[] 32; $rng.GetBytes($bytes); $rng.Dispose(); ($bytes | ForEach-Object { $_.ToString('x2') }) -join ''
# TASK_CURSOR_SIGNING_KEY=
